# Teto mensal de gasto com IA, válido para qualquer provedor.
# O sistema pausa sozinho ao atingir este valor.
OPENAI_MONTHLY_BUDGET_USD=25

# Provedor do motor de conversação: anthropic (padrão) ou openai
AI_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Identificadores exatos. Apelidos com "latest" são recusados na inicialização.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Preço por 1M de tokens do ANTHROPIC_MODEL (Opus 5: 5 / 25).
# O modelo rápido custa menos, então o custo estimado é conservador.
ANTHROPIC_INPUT_USD_PER_MILLION=5
ANTHROPIC_OUTPUT_USD_PER_MILLION=25
ANTHROPIC_PROJECTED_CALL_COST_USD=0.02

# --- OpenAI (usado apenas com AI_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_PROJECTED_CALL_COST_USD=
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=.chrome-profile
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v25.0
DATABASE_URL=data/prospecting.db
BUSINESS_CONFIG_PATH=config/business.json
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Cuiaba
BROWSER_MODE=simulated
INSTAGRAM_MODE=simulated
BROWSER_LIVE_AUTHORIZED=false
INSTAGRAM_LIVE_AUTHORIZED=false
